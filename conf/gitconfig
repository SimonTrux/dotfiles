[init]
	defaultBranch = main
[alias]
	b = branch
	ba = branch --all
	ls = log --oneline --graph # --all
	st = status
	s = status --short
  unstage = restore --staged
  ac = commit -a
[user]
	email = simon.truxillo@gmail.com
	name = SimonTrux
[gpg]
	format = ssh
[commit]
	gpgsign = false
[core]
	editor = vim
[credential "https://github.com"]
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = !gh auth git-credential
